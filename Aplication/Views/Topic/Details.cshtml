@using System.Security.Claims
@model MoralCompass.Web.Controllers.TopicController.TopicDetailModel
@{
    ViewData["Title"] = Model.Topic?.Title ?? "Тема";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/theme.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

    <!-- 🔹 Навигация -->
    <header class="header">
        <nav class="nav">
            <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
            <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
            <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="@Url.Action("Profile", "Index")" class="nav-link">Профиль</a>
        }
        else
        {
            <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
        }
    </header>

    <!-- 🔸 Описание родительской заповеди -->
    <div style="text-align: center; margin: 30px 0;">
        <h2 style="font-size: 36px; margin-bottom: 5px;">@Model.CoreThesis.Title</h2>
        <p class="description-p">@Model.Topic.Title</p>
    </div>

    <!-- 🔹 Кнопка "Добавить дилемму" -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div style="text-align: center; margin-bottom: 20px;">
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addDilemmaModal">
                Добавить тезис, дилемму, кейс
            </button>
        </div>

        <!-- Модальное окно -->
        <div class="modal fade" id="addDilemmaModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Новая дилемма</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="post" asp-action="AddDilemma" asp-controller="Topic">
                        <input type="hidden" name="id" value="@Model.Topic.Id" />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Описание / кейс</label>
                                <textarea name="content" class="form-control" rows="4"
                                    placeholder="Опишите ситуацию, аргументы 'за' и 'против'..." required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                            <button type="submit" class="btn btn-primary">Опубликовать</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- 🔹 Список дилемм -->
    <div class="scroll">
        @if (!Model.Dilemmas.Any())
        {
            <div style="text-align: center; padding: 50px 20px; font-size: 20px; color: #777;">
                В этой теме пока нет дилемм.
            </div>
        }
        else
        {
            @foreach (var dilemma in Model.Dilemmas)
            {
                <div class="card" style="margin-bottom: 20px;">
                    <p class="login-info">
                        @dilemma.Author.Nickname · @dilemma.Item.CreatedAt.ToString("dd.MM.yyyy")
                    </p>

                    <!-- Ссылка на детали дилеммы -->
                    <a href="@Url.Action("Details", "DiscussionItem", new { id = dilemma.Item.Id })"
                       style="text-decoration: none; color: inherit;">
                        <p class="comment-info">@dilemma.Item.Content</p>
                    </a>

                    <!-- Комментарии -->
                    <div class="top-comment">
                        <p class="comment-p">Комментарии (@dilemma.TotalCommentCount)</p>
                        @if (dilemma.TopComments.Any())
                        {
                            @foreach (var c in dilemma.TopComments.Take(2))
                            {
                                <div class="comment-card">
                                    <p class="comment-card-p">@c.Comment.Content</p>
                                </div>
                            }
                        }
                    </div>

                    <!-- 🔥 Реакции (лайк/дизлайк) -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="reactions" style="margin-top: 10px; display: flex; gap: 12px;">
                            <!-- Лайк -->
                            <button type="button"
                                    class="reaction-btn like-btn"
                                    data-dilemma-id="@dilemma.Item.Id"
                                    data-current-value="@(dilemma.UserReactionValue == 1 ? "1" : "0")"
                                    style="border: none; background: none; cursor: pointer; font-weight: bold; color: @(dilemma.UserReactionValue == 1 ? "#0d6efd" : "#6c757d");">
                                <img src="~/svg/like.svg" alt="Лайк" width="16" height="16" />
                                <span class="like-count">@dilemma.Likes</span>
                            </button>

                            <!-- Дизлайк -->
                            <button type="button"
                                    class="reaction-btn dislike-btn"
                                    data-dilemma-id="@dilemma.Item.Id"
                                    data-current-value="@(dilemma.UserReactionValue == -1 ? "-1" : "0")"
                                    style="border: none; background: none; cursor: pointer; font-weight: bold; color: @(dilemma.UserReactionValue == -1 ? "#dc3545" : "#6c757d");">
                                <img src="~/svg/dislike.svg" alt="Дизлайк" width="16" height="16" />
                                <span class="dislike-count">@dilemma.Dislikes</span>
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Обязательно:AntiForgeryToken для AJAX -->
    @Html.AntiForgeryToken()

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 🔹 AJAX для реакций -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.like-btn, .dislike-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const dilemmaId = this.dataset.dilemmaId;
                const isLike = this.classList.contains('like-btn');
                const currentValue = parseInt(this.dataset.currentValue);

                let newValue = 0;
                if (isLike) {
                    newValue = (currentValue === 1) ? 0 : 1;
                } else {
                    newValue = (currentValue === -1) ? 0 : -1;
                }

                const formData = new URLSearchParams();
                formData.append('id', dilemmaId);
                formData.append('value', newValue.toString());

                try {
                    const response = await fetch('@Url.Action("ToggleReaction", "DiscussionItem")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (!response.ok) throw new Error('Ошибка сети');

                    const result = await response.json();
                    if (result.success) {
                        const likeBtn = document.querySelector(`.like-btn[data-dilemma-id="${dilemmaId}"]`);
                        const dislikeBtn = document.querySelector(`.dislike-btn[data-dilemma-id="${dilemmaId}"]`);

                        likeBtn.querySelector('.like-count').textContent = result.likes;
                        dislikeBtn.querySelector('.dislike-count').textContent = result.dislikes;

                        likeBtn.dataset.currentValue = result.userReaction === 1 ? '1' : '0';
                        dislikeBtn.dataset.currentValue = result.userReaction === -1 ? '-1' : '0';

                        likeBtn.style.color = result.userReaction === 1 ? '#0d6efd' : '#6c757d';
                        dislikeBtn.style.color = result.userReaction === -1 ? '#dc3545' : '#6c757d';
                    }
                } catch (error) {
                    alert('Не удалось обновить реакцию. Попробуйте позже.');
                    console.error('AJAX error:', error);
                }
            });
        });
    });
</script>

</body>
</html>