@model MoralCompass.Infrastructure.Domain.Topic

@{
    ViewData["Title"] = "Редактировать тему";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="~/css/edit-topic.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

<main class="form-container">
    <h1 class="form-title">Редактировать тему</h1>

    <form asp-action="EditTopic" method="post" class="edit-form">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label for="title" class="form-label">Название темы</label>
            <input type="text"
                   id="title"
                   name="title"
                   value="@Model.Title"
                   class="form-control"
                   required
                   maxlength="200" />
            <span asp-validation-for="Title" class="text-danger form-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a href="@Url.Action("Details", "Thesis", new { id = Model.CoreThesisId })" class="btn btn-secondary">Отмена</a>        </div>
    </form>
</main>

</body>
</html>