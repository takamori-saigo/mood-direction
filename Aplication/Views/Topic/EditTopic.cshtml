@model MoralCompass.Infrastructure.Domain.Topic

@{
    ViewData["Title"] = "Редактировать тему";
}

<h2>Редактировать тему</h2>

<form asp-action="EditTopic" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label for="title">Название темы</label>
        <input type="text" id="title" name="title" value="@Model.Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="@Url.Action("Details", "Topic", new { id = Model.Id })" class="btn btn-secondary">Отмена</a>
</form>