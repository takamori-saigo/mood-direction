@{
    var thesis = ViewBag.Thesis as MoralCompass.Infrastructure.Domain.CoreThesis;
    ViewData["Title"] = "Новая тема";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/create-topic.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

<!-- 🔹 Навигация -->
<header class="header">
    <nav class="nav">
        <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
        <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
        <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
    <form asp-controller="Auth" asp-action="Logout" method="post" class="auth-form">
        <button type="submit" class="auth-btn" onclick="return confirm('Выйти из аккаунта?')">
            Выйти
        </button>
    </form>
    }
    else
    {
    <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
    }
</header>

<!-- 🔸 Заголовок -->
<div class="header-section">
    <h1 class="page-title">Добавить тему к заповеди:</h1>
    <p class="thesis-title">«@thesis?.Title»</p>
</div>

<!-- 🔹 Форма -->
<div class="form-container">
    <form asp-action="CreateTopic" asp-controller="Thesis" method="post">
        <input type="hidden" name="thesisId" value="@thesis?.Id" />

        <div class="form-group">
            <label class="form-label">Название темы</label>
            <input type="text"
                   name="title"
                   class="form-input"
                   placeholder="Например: «Можно ли врать во благо?»"
                   required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Создать тему</button>
            <a href="@Url.Action("Details", "Thesis", new { id = thesis?.Id })"
               class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

</body>
</html>