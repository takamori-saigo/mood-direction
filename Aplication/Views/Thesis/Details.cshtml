@model MoralCompass.Web.Controllers.ThesisController.ThesisDetailModel
@{
    ViewData["Title"] = Model.Thesis?.Title ?? "Заповедь";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/details.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

    <!-- 🔹 Навигация -->
    <header class="header">
        <nav class="nav">
            <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
            <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
            <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
        <form asp-controller="Auth" asp-action="Logout" method="post" class="auth-form">
            <button type="submit" class="auth-btn" onclick="return confirm('Выйти из аккаунта?')">
                Выйти
            </button>
        </form>
        }
        else
        {
        <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
        }
    </header>

    <!-- 🔸 Заголовок и описание -->
    <header class="thesis-header">
        <h1 class="thesis-title">@Model.Thesis?.Title</h1>
        <p class="thesis-description">@Model.Thesis?.Description</p>

        <div class="thesis-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="@Url.Action("CreateTopic", "Thesis", new { thesisId = Model.Thesis?.Id })"
                   class="btn btn-primary">
                    Добавить тему
                </a>
            }
            <a href="@Url.Action("Index", "Index")" class="btn btn-secondary">
                Все заповеди
            </a>
        </div>
    </header>

    <!-- 🔹 Список тем -->
    <main class="topics-scroll">
        @foreach (var topicGroup in Model.Topics)
        {
            <a href="@Url.Action("Details", "Topic", new { id = topicGroup.Topic.Id })" class="theme-link">
                <div class="theme-item">
                    <p class="theme-title">@topicGroup.Topic.Title</p>
                    <div class="icon">
                        <img src="~/images/arrow_right.png" alt="→">
                    </div>
                </div>
            </a>
        }
    </main>

</body>
</html>