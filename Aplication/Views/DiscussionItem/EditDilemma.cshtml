@model MoralCompass.Infrastructure.Domain.DiscussionItem

@{
ViewData["Title"] = "Редактировать дилемму";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/edit-dilemma.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

<main class="form-container">
    <h1 class="form-title">Редактировать дилемму</h1>

    <form asp-action="EditDilemma" asp-controller="DiscussionItem" method="post" class="edit-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label for="title" class="form-label">Заголовок</label>
            <input type="text"
                   id="title"
                   name="title"
                   value="@Model.Title"
                   class="form-control"
                   required
                   maxlength="200" />
            <span asp-validation-for="Title" class="text-danger form-error"></span>
        </div>

        <div class="form-group">
            <label for="content" class="form-label">Содержание</label>
            <textarea id="content"
                      name="content"
                      class="form-control"
                      rows="6"
                      required
                      maxlength="3000">@Model.Content</textarea>
            <span asp-validation-for="Content" class="text-danger form-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a href="@Url.Action("Details", "DiscussionItem", new { id = Model.Id })" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</main>

</body>
</html>