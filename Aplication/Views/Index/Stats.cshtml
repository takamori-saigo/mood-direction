@{
    ViewData["Title"] = "Статистика";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/stats.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

    <!-- 🔹 Навигация -->
    <header class="header">
        <nav class="nav">
            <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
            <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
            <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
        <form asp-controller="Auth" asp-action="Logout" method="post" class="auth-form">
            <button type="submit" class="auth-btn" onclick="return confirm('Выйти из аккаунта?')">
                Выйти
            </button>
        </form>
        }
        else
        {
        <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
        }
    </header>

    <!-- 🔸 Заголовок -->
    <div class="header-section">
        <div class="icon-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000" viewBox="0 0 16 16">
                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5v12h-2V2h2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2z"/>
            </svg>
        </div>
        <h1 class="page-title">Статистика</h1>
    </div>

    <!-- 🔹 Контент -->
    <div class="content-card">
        <p class="stats-categories">
            Гендерный баланс • Возрастные группы • География • Активность по темам
        </p>

        <div class="coming-soon">
            <h2>В скором обновлении</h2>
            <p class="coming-soon-text">
                Мы работаем над аналитикой: кто и как участвует в обсуждениях.  
                Скоро вы сможете видеть статистику в реальном времени.
            </p>
        </div>

        <div class="back-link">
            <a href="@Url.Action("Index", "Index")" class="btn btn-secondary">
                Назад на главную
            </a>
        </div>
    </div>

</body>
</html>