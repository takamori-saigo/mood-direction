@model Aplication.Controllers.IndexController.HomeIndexModel
@{
    ViewData["Title"] = "Моральный Компас";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/index.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
            <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
            <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
        <form asp-controller="Auth" asp-action="Logout" method="post" class="auth-form">
            <button type="submit" class="auth-btn" onclick="return confirm('Выйти из аккаунта?')">
                Выйти
            </button>
        </form>
        }
        else
        {
        <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
        }
    </header>

    <div class="circle-grid">
        @foreach (var thesis in Model.Theses.Take(6))
        {
            <a href="@Url.Action("Details", "Thesis", new { id = thesis.Id })"
               class="circle-item">
                @thesis.Title
            </a>
        }
    </div>

    @if (Model.TopDilemmas.Any())
    {
        <div class="dilemmas-section">
            <h2 class="titul-p">Горячее</h2>
            <div class="dilemmas-list">
                @foreach (var di in Model.TopDilemmas)
                {
                <a href="@Url.Action("Details", "DiscussionItem", new { id = di.Id })"
                   class="dilemma-item">
                    <div class="dilemma-content">
                        <p class="login-info">
                            @di.Author.Nickname · @di.CreatedAt.ToString("dd.MM.yyyy")
                        </p>
                        <p class="comment-info">@di.Title</p>
                    </div>
                </a>
                }
            </div>
        </div>
    }
</body>
</html>