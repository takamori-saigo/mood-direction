@model Aplication.Controllers.IndexController.UserProfileModel

@{
    ViewData["Title"] = "Мой профиль";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/index.css" rel="stylesheet" />
    <style>
        .profile-form {
            max-width: 600px;
            margin: 2rem auto;
            padding: 1.5rem;
            background: #f9f9f9;
            border-radius: 8px;
        }
        .form-group {
            margin-bottom: 1rem;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.3rem;
            font-weight: bold;
        }
        .form-group input {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .btn {
            padding: 0.5rem 1rem;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn:hover {
            background: #0056b3;
        }
        .text-success {
            color: green;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
            <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
            <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
            <a href="@Url.Action("Profile", "Index")" class="nav-link">Профиль</a>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Auth" asp-action="Logout" method="post" class="auth-form">
                <button type="submit" class="auth-btn" onclick="return confirm('Выйти из аккаунта?')">
                    Выйти
                </button>
            </form>
        }
        else
        {
            <a href="@Url.Action("Login", "Auth")" class="auth-btn">Войти</a>
        }
    </header>

    <div class="profile-form">
        <h2>Редактировать профиль</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="text-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Profile" method="post">
            <div class="form-group">
                <label>Email (нельзя изменить)</label>
                <input type="email" value="@Model.Email" disabled />
            </div>

            <div class="form-group">
                <label>Никнейм</label>
                <input asp-for="Nickname" />
                <span asp-validation-for="Nickname" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Телефон</label>
                <input asp-for="Phone" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Пол</label>
                <input asp-for="Gender" placeholder="М / Ж / Другое" />
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Возраст</label>
                <input asp-for="Age" type="number" min="1" max="120" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <button type="submit" class="btn">Сохранить</button>
        </form>
    </div>
</body>
</html>