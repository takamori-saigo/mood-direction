@model Aplication.Controllers.IndexController.UserProfileModel

@{
ViewData["Title"] = "Мой профиль";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/profile.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>

<header class="header">
    <nav class="nav">
        <a href="@Url.Action("Index", "Confession")" class="nav-link">Не мудак ли я?</a>
        <a href="@Url.Action("Index", "Index")" class="nav-link">Главная страница</a>
        <a href="@Url.Action("Stats", "Index")" class="nav-link">Статистика</a>
    </nav>
</header>

<main class="profile-container">
    <h1 class="profile-title">Редактировать профиль</h1>

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
    }

    <form asp-action="Profile" method="post" class="profile-form">
        <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" value="@Model.Email" disabled class="form-control-disabled" />
        </div>

        <div class="form-group">
            <label class="form-label">Никнейм</label>
            <input asp-for="Nickname" class="form-control" />
            <span asp-validation-for="Nickname" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Телефон</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Пол</label>
            <select asp-for="Gender" class="form-control">
                <option value="">-- Выберите --</option>
                <option value="Male">Мужской</option>
                <option value="Female">Женский</option>
                <option value="Other">Другое</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Возраст</label>
            <input asp-for="Age" type="number" min="1" max="120" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить</button>
        </div>
    </form>

    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
        <button type="submit" class="btn btn-secondary" onclick="return confirm('Выйти из аккаунта?')">
            Выйти
        </button>
    </form>
</main>

</body>
</html>