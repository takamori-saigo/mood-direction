@model Domain.DTO.RegisterRequest
@{
    ViewData["Title"] = "Регистрация";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/registration.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />
</head>
<body>
    <div class="header-section">
        <h1 class="page-title">Регистрация</h1>
    </div>

    <div class="form-card">
        <form asp-action="Register" method="post">
            <div class="form-group">
                <label class="form-label">Никнейм</label>
                <input asp-for="Nickname" class="form-input" placeholder="Введите никнейм" />
                <span asp-validation-for="Nickname" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Пароль</label>
                <input asp-for="Password" type="password" class="form-input" placeholder="●●●●●●●●" />
                <span asp-validation-for="Password" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Возраст</label>
                <input asp-for="Age" type="number" min="13" max="120" class="form-input" placeholder="18" />
                <span asp-validation-for="Age" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Пол</label>
                <select asp-for="Gender" class="form-select">
                    <option value="">— Выберите —</option>
                    <option value="0">Мужской</option>
                    <option value="1">Женский</option>
                    <option value="2">Другое</option>
                </select>
                <span asp-validation-for="Gender" class="text-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
        </form>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                @ViewBag.Message
            </div>
        }

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <div class="auth-link">
            Уже есть аккаунт? <a href="@Url.Action("Login", "Auth")">Войдите</a>
        </div>
    </div>

</body>
</html>
