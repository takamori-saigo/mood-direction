@model Domain.DTO.LoginRequest
@{
    ViewData["Title"] = "Вход";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/registration.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/icon.png" />    
</head>
<body>
    <div class="header-section">
        <h1 class="page-title">Вход</h1>
    </div>

    <div class="form-card">
        <form asp-action="Login" method="post">
            <div class="form-group">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Пароль</label>
                <input asp-for="Password" type="password" class="form-input" placeholder="●●●●●●●●" />
                <span asp-validation-for="Password" class="text-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Войти</button>
        </form>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                @ViewBag.Message
            </div>
        }

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }
        <div class="oauth-buttons">
            <a class="btn btn-google" href="/Auth/ExternalLogin?provider=Google" style="color: black; text-decoration: none;">
                Войти через Google
            </a>

            <a class="btn btn-yandex" href="/Auth/ExternalLogin?provider=Yandex" style="color: black; text-decoration: none;">
                Войти через Яндекс
            </a>
        </div>
        <div class="auth-link">
            Нет аккаунта? <a href="@Url.Action("Register", "Auth")">Зарегистрируйтесь</a>
        </div>
    </div>

</body>
</html>
